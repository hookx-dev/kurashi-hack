---
import Sidebar from '../components/Sidebar.astro';

const allArticles = Object.values(import.meta.glob('../pages/article-*.astro', { eager: true })) as any[];
const categoryCounts: Record<string, number> = {};
allArticles.forEach((article) => {
  const cat = article.category;
  if (cat) categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
const navCategories = Object.entries(categoryCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([cat]) => cat);

export interface Props {
    title: string;
    description?: string;
    category?: string;
    image?: string;
    date?: string;
}

const { 
  title, 
  description = "日々の生活の小さなイライラを解決する、本当に買ってよかったおすすめアイテムを厳選してご紹介します。", 
  category,
  image = "/favicon.svg",
  date
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
const socialImageURL = new URL(image, Astro.site || Astro.url);
const siteName = "KURASHI HACK";

// 構造化データ（JSON-LD）の作成
const schema = {
  "@context": "https://schema.org",
  "@type": date ? "Article" : "WebSite",
  "name": title,
  "headline": title,
  "description": description,
  "image": socialImageURL.toString(),
  "url": canonicalURL.toString(),
  ...(date && { "datePublished": date.replace(/\./g, '-') + "T00:00:00+09:00" }),
  "author": {
    "@type": "Person",
    "name": "KURASHI HACK編集部"
  },
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/favicon.svg", Astro.site || Astro.url).toString()
    }
  }
};
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    
    <!-- 正規化URL (Canonical) -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- OGP (Open Graph Protocol) -->
    <meta property="og:type" content={date ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- 構造化データ (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <div class="logo"><a href="/">KURASHI HACK</a></div>
            <nav class="global-nav">
                <ul>
                    <li><a href="/">ホーム</a></li>
                    {navCategories.map((cat) => (
                        <li><a href={`/category/${cat}`}>{cat}</a></li>
                    ))}
                    <li><a href="/about">運営者情報</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <slot name="hero" />

    <main class="container layout-2col">
        <div class="main-content">
            {category && (
                <nav class="breadcrumb">
                    <a href="/">ホーム</a> &gt; {category}
                </nav>
            )}
            <slot />
        </div>

        <Sidebar />
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-links">
                <a href="/">ホーム</a>
                <a href="/about">運営者情報</a>
                <a href="/privacy">プライバシーポリシー・免責事項</a>
            </div>
            <p>&copy; 2026 KURASHI HACK by Hookx.dev. All Rights Reserved.</p>
            <p class="disclaimer">※当サイトはAmazonアソシエイト・プログラムの参加者です。</p>
        </div>
    </footer>

    <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "fa12790d58bc4d0ca9eddb18d7179405"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>
