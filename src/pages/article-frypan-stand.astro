export const title = "【重ねない収納】フライパンスタンドおすすめ3選！シンク下の取り出しストレスを解消";
export const category = "キッチン";
export const date = "2026.08.26";
export const image = "/assets/frypan-stand.jpg";
export const excerpt = "フライパンを重ねて収納すると、下の物を取るたびに全部持ち上げる羽目に。立てて収納するだけで、その面倒な作業から解放されます。";
