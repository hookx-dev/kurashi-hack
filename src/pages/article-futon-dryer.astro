export const title = "【天日干し不要】布団乾燥機おすすめ3選！ふかふかの布団で眠る幸せ";
export const category = "リビング";
export const date = "2026.08.26";
export const image = "/assets/futon-dryer.jpg";
export const excerpt = "花粉や梅雨で布団を外に干せない日が続いていませんか？布団乾燥機なら天気を気にせず、ダニ対策までできてふかふかの寝心地が手に入ります。";
