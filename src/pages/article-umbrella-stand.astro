export const category = "収納";
export const date = "2026.08.26";
export const image = "/assets/umbrella-stand.jpg";
export const excerpt = "玄関のドア横に傘立てを置いただけで、通るたびに引っかかっていませんか？置き場所を変えるだけで、狭い玄関が驚くほど歩きやすくなります。";
